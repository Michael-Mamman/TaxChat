TIN_RETRIEVAL_FLOW=
TAX_CLEARANCE_FLOW=
PAYMENT_CONFIRMATION_FLOW=
PROFILE_UPDATE_FLOW=
FILING_SUPPORT_FLOW=
ASSESSMENT_QUERY_FLOW=
PENALTY_QUERY_FLOW=
WHT_CREDIT_NOTE_FLOW=
GENERAL_ENQUIRY_FLOW=

# ITSM (myservice/Odoo)
ITSM_BASE_URL=
ITSM_API_KEY=

# TaxProMax
TAXPROMAX_BASE_URL=
TAXPROMAX_API_KEY=

# JTB TIN System
JTB_BASE_URL=
JTB_API_KEY=

# Remita/GMP
REMITA_BASE_URL=
REMITA_MERCHANT_ID=
REMITA_API_KEY=

# NIMC (NIN Verification)
NIMC_BASE_URL=
NIMC_API_KEY=

# NIBSS (BVN Verification)
NIBSS_BASE_URL=
NIBSS_API_KEY=

# SMS Gateway
SMS_GATEWAY_URL=
SMS_API_KEY=

# Akraa AI Engine
AKRAA_AI_URL=
AKRAA_AI_API_KEY=

# Taxly/ATRS
TAXLY_BASE_URL=
TAXLY_API_KEY=

# CIN Analytics
CIN_BASE_URL=
CIN_API_KEY=

# Auth
# Where one-time passcodes are delivered: "sms" (production, needs
# SMS_GATEWAY_URL) or "whatsapp". WhatsApp delivery sends the code over the
# same chat it authenticates, so it is NOT a second factor - it exists because
# no SMS gateway is available yet, and must not be used in production.
OTP_DELIVERY_CHANNEL=sms
OTP_EXPIRY_SECONDS=300
SESSION_TIMEOUT_SECONDS=900
MAX_OTP_ATTEMPTS=3
